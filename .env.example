# ScoutNexus — Reddit API credentials (read-only).
#
# --- Application-level credentials (Stage 2/3 discovery) ---
# 1. Create a Reddit app at https://www.reddit.com/prefs/apps
#    - Click "are you a developer? create an app..."
#    - Choose type "script" (confidential client for your own hardware).
# 2. Copy this file to ".env" and fill in the values.
# 3. Never commit ".env" — it is gitignored.
#
# --- User-authorized OAuth (Stage 4 account connection) ---
# Register a SEPARATE app of type "web" (script apps cannot do the
# authorization-code flow). Set its redirect URI to EXACTLY the value of
# SCOUTNEXUS_REDDIT_REDIRECT_URI below — Reddit rejects mismatches.
# This is distinct from the script-app credentials above; do not reuse them.
#
# Placeholders only. No real credentials belong in this file.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Descriptive User-Agent is REQUIRED by Reddit. Format:
#   <platform>:<app-id>:<version> (by /u/<your-reddit-username>)
REDDIT_USER_AGENT=ScoutNexus/0.1 by YOUR_REDDIT_USERNAME

SCOUTNEXUS_REDDIT_CLIENT_ID=
SCOUTNEXUS_REDDIT_CLIENT_SECRET=
SCOUTNEXUS_REDDIT_REDIRECT_URI=http://127.0.0.1:8000/auth/reddit/callback
# Optional: overrides REDDIT_USER_AGENT for OAuth calls when set.
SCOUTNEXUS_REDDIT_USER_AGENT=
